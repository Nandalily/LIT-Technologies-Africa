<section class="admin-page">
<div class="container">
<div class="admin-top"><div><p class="eyebrow">LIT Admin / Content studio</p><h1>Publish something people can see.</h1><p>Manage hero slides, ribbon announcements, and the digital archive separately.</p></div><form method="post" action="/admin/logout"><button class="btn btn-outline-dark" type="submit">Sign out</button></form></div>
<% if (typeof query !== 'undefined' && query.saved) { %><div class="alert alert-success"><%= query.saved %> is now live.</div><% } %>
<div class="admin-upload-grid">
<form class="upload-panel" method="post" action="/admin/announcements" enctype="multipart/form-data"><h2>Hero images</h2><p class="panel-note">These images transition behind the homepage hero copy.</p><label for="announcementTitle">Hero label</label><input id="announcementTitle" name="announcementTitle" type="text" placeholder="e.g. Applications are open" required><label for="announcementFiles">Hero images <small>JPG, PNG, or WEBP · max 10MB each</small></label><input id="announcementFiles" name="announcementFiles" type="file" accept="image/jpeg,image/png,image/webp" multiple required><button class="btn btn-primary" type="submit">Add hero images <i class="bi bi-images"></i></button></form>
<form class="upload-panel" method="post" action="/admin/ribbon-announcements" enctype="multipart/form-data"><h2>Ribbon announcements</h2><p class="panel-note">These appear as image-led announcements in the lime ribbon.</p><label for="ribbonAnnouncementTitle">Ribbon message</label><input id="ribbonAnnouncementTitle" name="ribbonAnnouncementTitle" type="text" placeholder="e.g. New cohort applications open" required><label for="ribbonAnnouncementFiles">Ribbon images <small>JPG, PNG, or WEBP · max 10MB each</small></label><input id="ribbonAnnouncementFiles" name="ribbonAnnouncementFiles" type="file" accept="image/jpeg,image/png,image/webp" multiple required><button class="btn btn-primary" type="submit">Add ribbon announcements <i class="bi bi-megaphone"></i></button></form>
<form class="upload-panel" method="post" action="/admin/albums" enctype="multipart/form-data"><h2>New digital album</h2><p class="panel-note">Upload one PDF or a set of photos for the archive.</p><label for="title">Album title</label><input id="title" name="title" type="text" placeholder="e.g. LIT School Cohort 04" required><label for="description">Short description</label><textarea id="description" name="description" rows="2" placeholder="What is this collection about?"></textarea><label for="files">Pages <small>PDF, JPG, PNG, or WEBP · max 25MB each</small></label><input id="files" name="files" type="file" accept="application/pdf,image/jpeg,image/png,image/webp" multiple required><button class="btn btn-primary" type="submit">Publish album <i class="bi bi-upload"></i></button></form>
</div>
<div class="admin-content-grid">
<div class="admin-list"><h2>Hero library <span><%= announcements.length %></span></h2><% if (!announcements.length) { %><p class="panel-note">No hero images yet.</p><% } %><% announcements.forEach((announcement) => { %><div class="admin-album-row"><div class="admin-announcement-thumb"><img src="<%= announcement.image %>" alt=""><div><strong><%= announcement.title %></strong><small>Hero image</small></div></div><form method="post" action="/admin/announcements/<%= announcement.id %>/delete"><button class="btn btn-outline-danger btn-sm" type="submit">Remove</button></form></div><% }) %></div>
<div class="admin-list"><h2>Ribbon library <span><%= ribbonAnnouncements.length %></span></h2><% if (!ribbonAnnouncements.length) { %><p class="panel-note">No ribbon announcements yet.</p><% } %><% ribbonAnnouncements.forEach((announcement) => { %><div class="admin-album-row"><div class="admin-announcement-thumb"><img src="<%= announcement.image %>" alt=""><div><strong><%= announcement.title %></strong><small>Ribbon announcement</small></div></div><form method="post" action="/admin/ribbon-announcements/<%= announcement.id %>/delete"><button class="btn btn-outline-danger btn-sm" type="submit">Remove</button></form></div><% }) %></div>
</div>
<div class="admin-list admin-albums-list"><h2>Digital albums <span><%= albums.length %></span></h2><% if (!albums.length) { %><p class="panel-note">No albums uploaded yet.</p><% } %><% albums.forEach((album) => { %><div class="admin-album-row"><div><strong><%= album.title %></strong><small><%= album.files.length %> file(s) · <%= album.description || "No description" %></small></div><form method="post" action="/admin/albums/<%= album.id %>/delete"><button class="btn btn-outline-danger btn-sm" type="submit">Remove</button></form></div><% }) %></div>
</div>
</section>