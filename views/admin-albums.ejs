<section class="admin-page"><div class="container"><div class="admin-top"><div><p class="eyebrow">LIT Admin / Content studio</p><h1>Publish something people can see.</h1><p>Manage the digital archive and the announcement images shown on the homepage.</p></div><form method="post" action="/admin/logout"><button class="btn btn-outline-dark" type="submit">Sign out</button></form></div><% if (typeof query !== 'undefined' && query.saved) { %><div class="alert alert-success">“<%= query.saved %>” is now live.</div><% } %><div class="admin-grid"><form class="upload-panel" method="post" action="/admin/announcements" enctype="multipart/form-data"><h2>Homepage announcements</h2><p class="panel-note">These images transition in the homepage hero.</p><label for="announcementTitle">Announcement label</label><input id="announcementTitle" name="announcementTitle" type="text" placeholder="e.g. Applications are open" required><label for="announcementFiles">Announcement images <small>JPG, PNG, or WEBP · max 10MB each</small></label><input id="announcementFiles" name="announcementFiles" type="file" accept="image/jpeg,image/png,image/webp" multiple required><button class="btn btn-primary" type="submit">Publish announcements <i class="bi bi-megaphone"></i></button></form><form class="upload-panel" method="post" action="/admin/albums" enctype="multipart/form-data"><h2>New digital album</h2><p class="panel-note">Upload one PDF or a set of photos for the archive.</p><label for="title">Album title</label><input id="title" name="title" type="text" placeholder="e.g. LIT School Cohort 04" required><label for="description">Short description</label><textarea id="description" name="description" rows="2" placeholder="What is this collection about?"></textarea><label for="files">Pages <small>PDF, JPG, PNG, or WEBP · max 25MB each</small></label><input id="files" name="files" type="file" accept="application/pdf,image/jpeg,image/png,image/webp" multiple required><button class="btn btn-primary" type="submit">Publish album <i class="bi bi-cloud-arrow-up"></i></button></form><div class="admin-list"><h2>Homepage announcements <span><%= announcements.length %></span></h2><% if (!announcements.length) { %><p class="text-muted">No announcement images yet.</p><% } %><% announcements.forEach((announcement) => { %><div class="admin-album-row"><div class="admin-announcement-thumb"><img src="<%= announcement.image %>" alt="<%= announcement.title %>"><div><strong><%= announcement.title %></strong><small><%= new Date(announcement.createdAt).toLocaleDateString() %></small></div></div><form method="post" action="/admin/announcements/<%= announcement.id %>/delete"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></div><% }) %></div><div class="admin-list"><h2>Published albums <span><%= albums.length %></span></h2><% if (!albums.length) { %><p class="text-muted">No albums yet.</p><% } %><% albums.forEach((album) => { %><div class="admin-album-row"><div><strong><%= album.title %></strong><small><%= album.files.length %> pages · <%= new Date(album.createdAt).toLocaleDateString() %></small></div><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-dark" href="/album/<%= album.id %>" target="_blank">View</a><form method="post" action="/admin/albums/<%= album.id %>/delete"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></div></div><% }) %></div></div></div></section>
