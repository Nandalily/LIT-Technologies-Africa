<section class="hero-reference" id="top">
<div class="hero-reference-photo" data-hero-slideshow>
<% const heroImages = announcements && announcements.length ? announcements.map((announcement) => announcement.image) : ['/uploads/announcements/1790247138249-supply.jpg', '/images/training.png', '/images/about.jpg', '/images/enets.png']; %>
<% heroImages.forEach((image, index) => { %>
<div class="hero-reference-slide <%= index === 0 ? 'is-active' : '' %>" data-hero-slide style="background-image: url('<%= image %>');"></div>
<% }) %>
</div>
<div class="hero-reference-shade"></div>
<div class="container hero-reference-content">
<div class="hero-reference-copy" data-reveal>
<div class="hero-reference-kicker"><span>Learn</span><i></i><span>Connect</span><i></i><span>Grow</span></div>
<h1>Empowering Africa<br><em>Through Technology</em></h1>
<p>LIT Technologies Africa provides technology-driven solutions, training, and digital services to build skills, create opportunities and transform communities across Africa and beyond.</p>
<div class="hero-reference-actions">
<a href="/services" class="btn btn-primary">Explore Our Services <i class="bi bi-arrow-right"></i></a>
<a href="#about" class="btn hero-story-button"><i class="bi bi-play-fill"></i> Watch Our Story</a>
</div>
</div>
<div class="hero-reference-note" aria-label="Skills today. Opportunities tomorrow.">
<span>Skills<br>Today.<br>Opportunities<br>Tomorrow.</span>
<i></i>
</div>
</div>
</section>